# ==========================================================
# Configurações do Ambiente Local (Docker / Standalone)
# ==========================================================
APP_PORT=7998
PORT=7998
POSTGRES_DB=ecpelotas_local
POSTGRES_USER=pelotas_user
POSTGRES_PASSWORD=pelotas_pass

# Para rodar fora do Docker conectando no PostgreSQL local:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/ecpelotas_local
# SPRING_DATASOURCE_USERNAME=pelotas_user
# SPRING_DATASOURCE_PASSWORD=pelotas_pass

# Segurança JWT
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:7999

# Uploads Firebase
STORAGE_PROVIDER=firebase
FIREBASE_PROJECT_ID=esporteclubepelotasdev
FIREBASE_STORAGE_BUCKET=esporteclubepelotasdev.firebasestorage.app
FIREBASE_CREDENTIALS_BASE64=

# E-mails Resend
RESEND_API_KEY=

